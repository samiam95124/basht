$PRODUCES feed.c

$BUILTIN feed
$FUNCTION feed_builtin
$SHORT_DOC feed name[:n] text ...
Send a line of input to a multiplexed task.

Writes TEXT (the remaining arguments, joined by single spaces),
followed by a newline, to the standard input of the named task,
without foregrounding it. Tasks are addressed by their display
tag: `feed hello:2 ...' feeds the task tagged [hello:2] (the
second hello of the session). The :n part may be omitted when
exactly one task with that name is alive.

(This is the `in' builtin of the tsh design; `in' itself is a
shell reserved word and cannot name a builtin.)

Exit Status:
Returns success unless the spec names no live task, or names more
than one and :n was omitted.
$END

#include <config.h>

#if defined (HAVE_UNISTD_H)
#  include <unistd.h>
#endif

#include "../bashintl.h"
#include "../shell.h"
#include "common.h"

extern int basht_active;
extern int basht_send_input (const char *, int, const char *);

int
feed_builtin (WORD_LIST *list)
{
  WORD_LIST *l;
  intmax_t inst;
  char *spec, *colon;
  char name[64];
  char line[4096];
  size_t n, w;
  int r;

  if (list == 0 || list->next == 0)
    {
      builtin_usage ();
      return (EX_USAGE);
    }
  if (basht_active == 0)
    {
      builtin_error (_("task multiplexer is not active"));
      return (EXECUTION_FAILURE);
    }

  /* task spec: name or name:n */
  spec = list->word->word;
  inst = -1;
  colon = strrchr (spec, ':');
  if (colon)
    {
      if (valid_number (colon + 1, &inst) == 0 || inst <= 0)
	{
	  sh_invalidnum (colon + 1);
	  return (EXECUTION_FAILURE);
	}
      w = (size_t)(colon - spec);
    }
  else
    w = strlen (spec);
  if (w == 0 || w >= sizeof name)
    {
      builtin_error (_("%s: invalid task name"), spec);
      return (EXECUTION_FAILURE);
    }
  memcpy (name, spec, w);
  name[w] = '\0';

  n = 0;
  for (l = list->next; l; l = l->next)
    {
      w = strlen (l->word->word);
      if (n + w + 2 > sizeof line)
	break;
      memcpy (line + n, l->word->word, w);
      n += w;
      if (l->next)
	line[n++] = ' ';
    }
  line[n] = '\0';

  r = basht_send_input (name, (int)inst, line);
  if (r == -2)
    {
      builtin_error (_("%s: several tasks match; use %s:n"), spec, name);
      return (EXECUTION_FAILURE);
    }
  if (r < 0)
    {
      builtin_error (_("%s: no such task"), spec);
      return (EXECUTION_FAILURE);
    }
  return (EXECUTION_SUCCESS);
}
