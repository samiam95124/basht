$PRODUCES feed.c

$BUILTIN feed
$FUNCTION feed_builtin
$SHORT_DOC feed id text ...
Send a line of input to a multiplexed task.

Writes TEXT (the remaining arguments, joined by single spaces),
followed by a newline, to the standard input of the task whose
display tag is [name:ID], without foregrounding it. The task ids
are the numbers shown in the output tags.

(This is the `in' builtin of the tsh design; `in' itself is a
shell reserved word and cannot name a builtin.)

Exit Status:
Returns success unless ID does not name a live captured task.
$END

#include <config.h>

#if defined (HAVE_UNISTD_H)
#  include <unistd.h>
#endif

#include "../bashintl.h"
#include "../shell.h"
#include "common.h"

extern int basht_active;
extern int basht_send_input (int, const char *);

int
feed_builtin (WORD_LIST *list)
{
  WORD_LIST *l;
  intmax_t id;
  char line[4096];
  size_t n, w;

  if (list == 0 || list->next == 0)
    {
      builtin_usage ();
      return (EX_USAGE);
    }
  if (basht_active == 0)
    {
      builtin_error (_("task multiplexer is not active"));
      return (EXECUTION_FAILURE);
    }
  if (valid_number (list->word->word, &id) == 0 || id <= 0)
    {
      sh_invalidnum (list->word->word);
      return (EXECUTION_FAILURE);
    }

  n = 0;
  for (l = list->next; l; l = l->next)
    {
      w = strlen (l->word->word);
      if (n + w + 2 > sizeof line)
	break;
      memcpy (line + n, l->word->word, w);
      n += w;
      if (l->next)
	line[n++] = ' ';
    }
  line[n] = '\0';

  if (basht_send_input ((int)id, line) < 0)
    {
      builtin_error (_("%d: no such task"), (int)id);
      return (EXECUTION_FAILURE);
    }
  return (EXECUTION_SUCCESS);
}
